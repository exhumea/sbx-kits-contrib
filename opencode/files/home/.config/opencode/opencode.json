{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "todo": true,
    "subagent_depth": 1,
    "background_compaction": false
  },
  "providers": {
    "lbrouter": {
      "name": "lbrouter",
      "env": [
        "LBROUTER_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://lbrouter.com/v1"
      },
      "models": {
        "deepseek-v4.1-flash:free": {
          "name": "DeepSeek V4.1 Flash (free)"
        },
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash (low cost)"
        },
        "NVIDIA-Nemotron-3.5-Super-VL-120B": {
          "name": "NVIDIA Nemotron 3.5 Super VL 120B (free)"
        }
      }
    },
    "tokenharbor": {
      "name": "TokenHarbor",
      "env": [
        "TOKENHARBOR_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://tokenharbor.ai/v1"
      },
      "models": {
        "deepseek-v4.1-flash:free": {
          "name": "DeepSeek V4.1 Flash (free)"
        },
        "mimo-v2.6-flash:free": {
          "name": "MiMo V2.6 Flash (free)"
        }
      }
    },
    "freepi": {
      "name": "free-pi",
      "env": [
        "FREEPI_TOKEN",
        "FREEPI_VERSION"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.freepi.ai/v1"
      },
      "headers": {
        "user-agent": "pi (linux; arm64)",
        "x-client-version": "{env:FREEPI_VERSION}",
        "x-freepi-tool-errors": "v1:"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash (free)"
        },
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash (free)"
        }
      }
    }
  }
}