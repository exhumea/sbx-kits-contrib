alias grep='grep --color=auto'
alias diff='diff -Naur --color=auto'
alias ls='ls -AF --group-directories-first --time-style=+"%Y-%m-%d %H:%M" --color=auto' # --sort=time
alias ll='ls -lh' # --si
alias without_net='unshare --user --map-root-user --net'

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
